# Copy this file to config.env and fill in your details:
#   cp config.example.env config.env

# Required: the certificate and confirmation are sent to this address.
EMAIL=you@example.com

# Fixed values used for every request (defaults shown match what's used
# if you omit them).
DOMAINS=test.example.nl
PHONE=+31 6 12345678
KEY_SIZE=4096

# Mailbox the certificate email is sent to (IMAP), should be the same
# address as EMAIL above. Optional: leave MAIL_SERVER unset/blank to
# skip waiting for the email - the script then stops right after
# submitting the request and printing the PFX password.
MAIL_USERNAME=you@domain.nl
MAIL_PASSWORD=your-mailbox-password
MAIL_SERVER=mail.example.com

# Optional overrides.
MAIL_SENDER=g4trial@pkipartners.nl
MAIL_POLL_INTERVAL=15
MAIL_TIMEOUT=600

# Extracted certificate files are written to
# OUTPUT_FOLDER/{oin}-{cn}-{datetime}/
OUTPUT_FOLDER=./output
